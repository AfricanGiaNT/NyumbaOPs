# Nest API (set on the API host)
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:PORT/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:PORT/DATABASE
JWT_SECRET=replace_me
DASHBOARD_URL=https://dashboard.example.com
PUBLIC_URL=https://public.example.com
EXTRA_ALLOWED_ORIGINS=
GMAIL_USER=owner@example.com
GMAIL_APP_PASSWORD=replace_me
SUPABASE_PROJECT_REF=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=property-images
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Set on both Next.js deployments: Nest origin, without /api
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Set on the public site for legacy dashboard redirects
# DASHBOARD_URL=https://dashboard.example.com

# Set on the dashboard for public cache revalidation
PUBLIC_APP_URL=https://public.example.com
REVALIDATION_SECRET=replace_me
